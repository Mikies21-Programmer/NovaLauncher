<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- El material criptográfico y la configuración de Hidden Apps dependen de claves y contexto locales y no deben respaldarse ni restaurarse en otro dispositivo -->
        <exclude domain="sharedpref" path="nova_hidden_apps_vault.xml" />
        <exclude domain="sharedpref" path="nova_hidden_apps_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_hidden_apps_vault.xml" />
        <exclude domain="sharedpref" path="nova_hidden_apps_prefs.xml" />
    </device-transfer>
</data-extraction-rules>