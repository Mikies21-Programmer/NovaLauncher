<?xml version="1.0" encoding="utf-8"?><!--
    Android 12 / API 31 and later: selected by android:dataExtractionRules.
    Cloud backup and device transfer each preserve the Hidden Apps exclusions.
    General data keeps the platform default eligibility; this does not prove a backup occurred.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- El material criptográfico y la configuración de Hidden Apps dependen de claves y contexto locales y no deben respaldarse ni restaurarse en otro dispositivo -->
        <exclude domain="sharedpref" path="nova_hidden_apps_vault.xml" />
        <exclude domain="sharedpref" path="nova_hidden_apps_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nova_hidden_apps_vault.xml" />
        <exclude domain="sharedpref" path="nova_hidden_apps_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
