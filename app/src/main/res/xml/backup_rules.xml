<?xml version="1.0" encoding="utf-8"?><!--
    Android 11 / API 30 and earlier: selected by android:fullBackupContent.
    Android 12+ uses data_extraction_rules.xml for this targetSdk.
    Default-eligible general data remains restorable; Hidden Apps stores are excluded.
-->
<full-backup-content>
    <!-- El material criptográfico y la configuración de Hidden Apps dependen de claves y contexto locales y no deben respaldarse ni restaurarse en otro dispositivo -->
    <exclude domain="sharedpref" path="nova_hidden_apps_vault.xml" />
    <exclude domain="sharedpref" path="nova_hidden_apps_prefs.xml" />
</full-backup-content>
