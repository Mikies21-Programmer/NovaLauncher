    <!-- Prominent Disclosure Strings (ES) -->
    <string name="accessibility_disclosure_title">Uso del Servicio de Accesibilidad</string>
    <string name="accessibility_disclosure_message">NovaLauncher utiliza el Servicio de Accesibilidad exclusivamente para ejecutar acciones globales del sistema mediante gestos y accesos directos:\n\n• Doble toque: bloquear la pantalla.\n• Deslizar hacia abajo: abrir el panel de notificaciones.\n• Tocar el contador de mensajes: abrir el panel de notificaciones.\n\nNovaLauncher no utiliza el servicio para leer el contenido de otras aplicaciones, extraer texto de la pantalla ni registrar o transmitir el contenido de eventos de accesibilidad.\n\nEstas funciones son opcionales y el usuario debe aceptar esta divulgación antes de configurar el servicio en los ajustes del sistema.</string>
    <string name="accessibility_disclosure_accept">Aceptar y configurar</string>
    <string name="accessibility_disclosure_cancel">Ahora no</string>

