    <!-- Prominent Disclosure Strings (EN) -->
    <string name="accessibility_disclosure_title">Accessibility Service Usage</string>
    <string name="accessibility_disclosure_message">NovaLauncher uses the Accessibility Service exclusively to perform system global actions via gestures and shortcuts:\n\n• Double tap: lock the screen.\n• Swipe down: open the notification panel.\n• Tap the message counter: open the notification panel.\n\nNovaLauncher does not use the service to read content from other applications, extract screen text, or record or transmit any accessibility event content.\n\nThese features are optional and the user must accept this disclosure before configuring the service in system settings.</string>
    <string name="accessibility_disclosure_accept">Accept &amp; Configure</string>
